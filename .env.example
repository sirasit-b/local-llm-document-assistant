# Copy to .env and fill in. Never commit .env; never put real credentials here.

APP_ENV=development
LOG_LEVEL=INFO

# --- Database / Vector DB (pgvector lives in the same Postgres instance) ---
POSTGRES_USER=docassist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docassist
POSTGRES_PORT=5432
# Read by the backend when it runs outside Docker:
DATABASE_URL=postgresql+psycopg://docassist:change-me@localhost:5432/docassist
VECTOR_DB_URL=postgresql+psycopg://docassist:change-me@localhost:5432/docassist

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
OCR_PORT=8800
OLLAMA_PORT=11434

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- AI engine defaults (administrators can override these from the UI) ---
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# --- Local AI ---
# ollama | vllm | openai_compatible
LOCAL_PROVIDER_TYPE=ollama
OLLAMA_BASE_URL=http://ollama:11434
VLLM_BASE_URL=
LOCAL_API_KEY=

# --- OpenAI (external service; not containerised) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- OCR ---
OCR_PROVIDER=tesseract
OCR_BASE_URL=http://ocr:8800

# --- Privacy policy, enforced server-side ---
LOCAL_ONLY_MODE=false

# --- Retrieval tuning ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=6
MAX_UPLOAD_MB=50
